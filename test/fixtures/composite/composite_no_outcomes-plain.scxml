<scxml initial="s_blk_ROOT" name="bdoc_declaredoutcomes" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_ROOT" initial="s_blk_CS_body"><transition event="done.state.s_blk_CS_body" target="s_blk_ROOT__o_done" type="internal"/><state id="s_blk_CS_body" initial="s_blk_CS_wait"><onexit><cancel sendid="s_blk_CS_wait__send"/></onexit><transition event="done.state.s_blk_CS_wait" target="s_blk_CS_body__o_done" type="internal"/><state id="s_blk_CS_wait" initial="s_blk_CS_wait__waiting"><state id="s_blk_CS_wait__waiting"><onentry><send delay="10m" event="statifier_blocks.await.blk_CS_wait" id="s_blk_CS_wait__send"/></onentry><transition event="signup.confirmed" target="s_blk_CS_wait__o_received"/><transition event="statifier_blocks.await.blk_CS_wait" target="s_blk_CS_wait__o_timed_out"/></state><final id="s_blk_CS_wait__o_received"><onentry><raise event="done.outcome.s_blk_CS_wait.received"/></onentry></final><final id="s_blk_CS_wait__o_timed_out"><onentry><raise event="done.outcome.s_blk_CS_wait.timed_out"/></onentry></final></state><final id="s_blk_CS_body__o_done"><onentry><raise event="done.outcome.s_blk_CS_body.done"/></onentry></final></state><final id="s_blk_ROOT__o_done"><onentry><raise event="done.outcome.s_blk_ROOT.done"/></onentry></final></state></scxml>