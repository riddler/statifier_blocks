 event="done.outcome.s_blk_SCREEN_screen.done"/></onentry></final></state><final id="s_blk_SCREEN__o_chose_personal"><onentry><raise event="done.outcome.s_blk_SCREEN.chose_personal"/></onentry></final><final id="s_blk_SCREEN__o_chose_business"><onentry><raise event="done.outcome.s_blk_SCREEN.chose_business"/></onentry></final><final id="s_blk_SCREEN__o_went_back"><onentry><raise event="done.outcome.s_blk_SCREEN.went_back"/></onentry></final><final id="s_blk_SCREEN__o_timed_out"><onentry><raise event="done.outcome.s_blk_SCREEN.timed_out"/></onentry></final></state><final id="s_blk_ROOT__o_done"><onentry><raise event="done.outcome.s_blk_ROOT.done"/></onentry></final></state></scxml>