<scxml initial="s_blk_SEQ" name="bdoc_INVOKE" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_SEQ" initial="s_blk_INV"><transition event="done.state.s_blk_INV" target="s_blk_SEQ__o_done" type="internal"/><state id="s_blk_INV" initial="s_blk_INV__running"><state id="s_blk_INV__running"><invoke type="myapp:authorize"/><transition event="done.invoke" target="s_blk_INV__o_done"><assign expr="_event.data" location="cards.auth"/></transition><transition event="error.communication.invoke" target="s_blk_ERR"/></state><state id="s_blk_ERR" initial="s_blk_ERR__o_done"><final id="s_blk_ERR__o_done"><onentry><raise event="done.outcome.s_blk_ERR.done"/></onentry></final></state><transition event="done.state.s_blk_ERR" target="s_blk_INV__o_error" type="internal"/><final id="s_blk_INV__o_done"><onentry><raise event="done.outcome.s_blk_INV.done"/></onentry></final><final id="s_blk_INV__o_error"><onentry><raise event="done.outcome.s_blk_INV.error"/></onentry></final></state><final id="s_blk_SEQ__o_done"><onentry><raise event="done.outcome.s_blk_SEQ.done"/></onentry></final><transition event="done.outcome.s_blk_SEQ.done" target="s_blk_SEQ__root_done"/></state><final id="s_blk_SEQ__root_done"/></scxml>