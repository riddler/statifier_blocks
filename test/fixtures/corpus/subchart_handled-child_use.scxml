<scxml initial="s_blk_SUB" name="bdoc_SUB" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_SUB" initial="s_blk_SUB__running"><state id="s_blk_SUB__running"><invoke id="blk_SUB" src="bdoc_CHILD" type="statifier_blocks:subchart"/><transition cond="_event.data.outcome === 'approved'" event="done.invoke" target="s_blk_SUB__o_approved"/><transition cond="_event.data.outcome === 'declined'" event="done.invoke" target="s_blk_SUB__o_declined"/><transition event="done.invoke" target="s_blk_SUB__o_approved"/><transition event="error.communication.invoke" target="s_blk_SERR"/></state><state id="s_blk_SERR" initial="s_blk_SERR__o_done"><final id="s_blk_SERR__o_done"><onentry><raise event="done.outcome.s_blk_SERR.done"/></onentry></final></state><transition event="done.state.s_blk_SERR" target="s_blk_SUB__o_error" type="internal"/><final id="s_blk_SUB__o_approved"><onentry><raise event="done.outcome.s_blk_SUB.approved"/></onentry></final><final id="s_blk_SUB__o_declined"><onentry><raise event="done.outcome.s_blk_SUB.declined"/></onentry></final><final id="s_blk_SUB__o_error"><onentry><raise event="done.outcome.s_blk_SUB.error"/></onentry></final><transition event="done.outcome.s_blk_SUB.approved" target="s_blk_SUB__child_approved"/><transition event="done.outcome.s_blk_SUB.declined" target="s_blk_SUB__child_declined"/><transition event="done.outcome.s_blk_SUB.error" target="s_blk_SUB__child_error"/></state><final id="s_blk_SUB__child_approved"><donedata><param expr="'approved'" name="outcome"/></donedata></final><final id="s_blk_SUB__child_declined"><donedata><param expr="'declined'" name="outcome"/></donedata></final><final id="s_blk_SUB__child_error"><donedata><param expr="'error'" name="outcome"/><param expr="'failed'" name="statifier_persistence:run_status"/></donedata></final></scxml>