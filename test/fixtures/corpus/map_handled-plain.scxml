<scxml initial="s_blk_MAP" name="bdoc_MAP" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_MAP" initial="s_blk_MAP__running"><state id="s_blk_MAP__running"><invoke id="blk_MAP" src="bdoc_CHILD" type="statifier_blocks:map"><param expr="'signup.invitees'" name="items"/><param expr="'bdoc_CHILD'" name="chart"/><param expr="'invitee'" name="item_as"/><param expr="'answers'" name="collect"/><param expr="'all'" name="on"/></invoke><transition event="done.invoke" target="s_blk_MAP__o_done"><assign expr="_event.data" location="answers"/></transition><transition event="error.communication.invoke" target="s_blk_MERR"/></state><state id="s_blk_MERR" initial="s_blk_MERR__o_done"><final id="s_blk_MERR__o_done"><onentry><raise event="done.outcome.s_blk_MERR.done"/></onentry></final></state><transition event="done.state.s_blk_MERR" target="s_blk_MAP__o_error" type="internal"/><final id="s_blk_MAP__o_done"><onentry><raise event="done.outcome.s_blk_MAP.done"/></onentry></final><final id="s_blk_MAP__o_error"><onentry><raise event="done.outcome.s_blk_MAP.error"/></onentry></final></state></scxml>