<scxml initial="s_blk_ROOT" name="bdoc_01JDOC" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><datamodel><data id="budget_remaining"/><data id="amount"/></datamodel><state id="s_blk_ROOT" initial="s_blk_AUTH"><transition event="done.state.s_blk_AUTH" target="s_blk_GRP" type="internal"/><transition event="done.state.s_blk_GRP" target="s_blk_ROOT__o_done" type="internal"/><state id="s_blk_AUTH" initial="s_blk_AUTH__running"><state id="s_blk_AUTH__running"><invoke id="s_blk_AUTH__invocation" type="myapp:authorize"/><transition event="done.invoke.s_blk_AUTH__invocation" target="s_blk_AUTH__o_done"/><transition event="error.execution" target="s_blk_AUTH__o_done"/></state><final id="s_blk_AUTH__o_done"><onentry><raise event="done.outcome.s_blk_AUTH.done"/></onentry></final></state><state id="s_blk_GRP" initial="s_blk_GRP__run"><transition event="done.state.s_blk_GRP__body" target="s_blk_GRP__o_done" type="internal"/><transition event="statifier_blocks.interrupt.abandon" target="s_blk_GRP__o_done" type="internal"/><transition event="statifier_blocks.interrupt.resume" target="s_blk_GRP__history" type="internal"/><parallel id="s_blk_GRP__run"><state id="s_blk_GRP__body" initial="s_blk_BR"><transition event="done.state.s_blk_BR" target="s_blk_GRP__body_done" type="internal"/><state id="s_blk_BR" initial="s_blk_BR__pick"><state id="s_blk_BR__pick"><transition cond="budget_remaining &gt; amount" target="s_blk_PAR"/><transition target="s_blk_NO2"/></state><transition event="done.state.s_blk_PAR" target="s_blk_BR__o_done" type="internal"/><transition event="done.state.s_blk_NO2" target="s_blk_BR__o_done" type="internal"/><state id="s_blk_PAR" initial="s_blk_PAR__run"><transition event="done.state.s_blk_PAR__run" target="s_blk_PAR__o_done" type="internal"/><parallel id="s_blk_PAR__run"><state id="s_blk_PAR__lane_capture" initial="s_blk_CAP"><transition event="done.state.s_blk_CAP" target="s_blk_PAR__done_lane_capture" type="internal"/><state id="s_blk_CAP" initial="s_blk_CAP__running"><state id="s_blk_CAP__running"><invoke id="s_blk_CAP__invocation" type="myapp:capture"/><transition event="done.invoke.s_blk_CAP__invocation" target="s_blk_CAP__o_done"/><transition event="error.execution" target="s_blk_CAP__o_done"/></state><final id="s_blk_CAP__o_done"><onentry><raise event="done.outcome.s_blk_CAP.done"/></onentry></final></state><final id="s_blk_PAR__done_lane_capture"/></state><state id="s_blk_PAR__lane_receipt" initial="s_blk_WAI"><onexit><cancel sendid="s_blk_WAI__send"/></onexit><transition event="done.state.s_blk_WAI" target="s_blk_NOT" type="internal"/><transition event="done.state.s_blk_NOT" target="s_blk_PAR__done_lane_receipt" type="internal"/><state id="s_blk_WAI" initial="s_blk_WAI__waiting"><state id="s_blk_WAI__waiting"><onentry><send delay="48h" event="statifier_blocks.wait.blk_WAI" id="s_blk_WAI__send"/></onentry><transition event="statifier_blocks.wait.blk_WAI" target="s_blk_WAI__o_done"/></state><final id="s_blk_WAI__o_done"><onentry><raise event="done.outcome.s_blk_WAI.done"/></onentry></final></state><state id="s_blk_NOT" initial="s_blk_NOT__running"><state id="s_blk_NOT__running"><invoke id="s_blk_NOT__invocation" type="myapp:notify"/><transition event="done.invoke.s_blk_NOT__invocation" target="s_blk_NOT__o_done"/><transition event="error.execution" target="s_blk_NOT__o_done"/></state><final id="s_blk_NOT__o_done"><onentry><raise event="done.outcome.s_blk_NOT.done"/></onentry></final></state><final id="s_blk_PAR__done_lane_receipt"/></state></parallel><final id="s_blk_PAR__o_done"><onentry><raise event="done.outcome.s_blk_PAR.done"/></onentry></final></state><state id="s_blk_NO2" initial="s_blk_NO2__running"><state id="s_blk_NO2__running"><invoke id="s_blk_NO2__invocation" type="myapp:notify"/><transition event="done.invoke.s_blk_NO2__invocation" target="s_blk_NO2__o_done"/><transition event="error.execution" target="s_blk_NO2__o_done"/></state><final id="s_blk_NO2__o_done"><onentry><raise event="done.outcome.s_blk_NO2.done"/></onentry></final></state><final id="s_blk_BR__o_done"><onentry><raise event="done.outcome.s_blk_BR.done"/></onentry></final></state><final id="s_blk_GRP__body_done"/><history id="s_blk_GRP__history" type="deep"><transition target="s_blk_BR"/></history></state><state id="s_blk_INT" initial="s_blk_INT__armed"><state id="s_blk_INT__armed"><transition event="myapp.cancelled" target="s_blk_INT__o_done"><raise event="statifier_blocks.interrupt.abandon"/></transition></state><final id="s_blk_INT__o_done"><onentry><raise event="done.outcome.s_blk_INT.done"/></onentry></final></state></parallel><final id="s_blk_GRP__o_done"><onentry><raise event="done.outcome.s_blk_GRP.done"/></onentry></final></state><final id="s_blk_ROOT__o_done"><onentry><raise event="done.outcome.s_blk_ROOT.done"/></onentry></final><transition event="done.outcome.s_blk_ROOT.done" target="s_blk_ROOT__root_done"/></state><final id="s_blk_ROOT__root_done"/></scxml>