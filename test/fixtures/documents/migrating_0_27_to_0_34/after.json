{
  "schema_version": 1,
  "id": "bdoc_PATRONMIGRATE",
  "revision": 2,
  "metadata": {"name": "Patron registration, moved to declared outcomes"},
  "root": {
    "id": "blk_ROOT",
    "type": "core.sequence",
    "type_version": 1,
    "slots": {
      "body": [
        {
          "id": "blk_VERIFY",
          "type": "library.verify_email",
          "type_version": 1,
          "config": {"event": "email.verified"},
          "slots": {
            "on_received": [
              {
                "id": "blk_INTERESTS",
                "type": "core.assign",
                "type_version": 1,
                "config": {"path": "registration.screen", "value": "\"interests\""}
              }
            ],
            "on_went_back": [
              {
                "id": "blk_DETAILS",
                "type": "core.assign",
                "type_version": 1,
                "config": {"path": "registration.screen", "value": "\"details\""}
              }
            ]
          }
        }
      ]
    }
  }
}
