<scxml initial="s_blk_ROOT" name="bdoc_01JHOLDCONFIRM" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_ROOT" initial="s_blk_PLACE"><transition event="done.state.s_blk_PLACE" target="s_blk_CONFIRM" type="internal"/><transition event="done.state.s_blk_CONFIRM" target="s_blk_LEND" type="internal"/><transition event="done.state.s_blk_LEND" target="s_blk_ROOT__o_done" type="internal"/><state id="s_blk_PLACE" initial="s_blk_PLACE__o_done"><onentry><send event="hold.placed" id="s_blk_PLACE__send"/></onentry><final id="s_blk_PLACE__o_done"><onentry><raise event="done.outcome.s_blk_PLACE.done"/></onentry></final></state><state id="s_blk_CONFIRM" initial="s_blk_CONFIRM__run"><transition event="done.state.s_blk_CONFIRM__body" target="s_blk_CONFIRM__o_done" type="internal"/><transition event="statifier_blocks.interrupt.abandon.s_blk_CONFIRM" target="s_blk_CONFIRM__o_done" type="internal"/><transition event="statifier_blocks.interrupt.resume.s_blk_CONFIRM" target="s_blk_CONFIRM__run" type="internal"/><parallel id="s_blk_CONFIRM__run"><state id="s_blk_CONFIRM__body" initial="s_blk_TIMER"><onexit><cancel sendid="s_blk_TIMER__send"/></onexit><transition event="done.state.s_blk_TIMER" target="s_blk_WAIT" type="internal"/><transition event="done.state.s_blk_WAIT" target="s_blk_CONFIRM__body_done" type="internal"/><state id="s_blk_TIMER" initial="s_blk_TIMER__o_done"><onentry><send delay="1d" event="deadline.hold_confirm" id="s_blk_TIMER__send"/></onentry><final id="s_blk_TIMER__o_done"><onentry><raise event="done.outcome.s_blk_TIMER.done"/></onentry></final></state><state id="s_blk_WAIT" initial="s_blk_WAIT__waiting"><state id="s_blk_WAIT__waiting"><transition event="hold.confirmed" target="s_blk_WAIT__o_received"/></state><final id="s_blk_WAIT__o_received"><onentry><raise event="done.outcome.s_blk_WAIT.received"/></onentry></final></state><final id="s_blk_CONFIRM__body_done"/></state><state id="s_blk_EXPIRE" initial="s_blk_EXPIRE__armed"><state id="s_blk_EXPIRE__armed"><transition event="deadline.hold_confirm" target="s_blk_EXPIRE__o_done"><raise event="statifier_blocks.interrupt.abandon.s_blk_CONFIRM"/></transition></state><final id="s_blk_EXPIRE__o_done"><onentry><raise event="done.outcome.s_blk_EXPIRE.done"/></onentry></final></state></parallel><final id="s_blk_CONFIRM__o_done"><onentry><raise event="done.outcome.s_blk_CONFIRM.done"/></onentry></final></state><state id="s_blk_LEND" initial="s_blk_LEND__o_done"><onentry><send event="loan.checked_out" id="s_blk_LEND__send"/></onentry><final id="s_blk_LEND__o_done"><onentry><raise event="done.outcome.s_blk_LEND.done"/></onentry></final></state><final id="s_blk_ROOT__o_done"><onentry><raise event="done.outcome.s_blk_ROOT.done"/></onentry></final></state></scxml>