<scxml initial="s_blk_ROOT" name="bdoc_AWAITCAPTURE" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_ROOT" initial="s_blk_REQ"><onexit><cancel sendid="s_blk_REQ__send"/></onexit><transition event="done.state.s_blk_REQ" target="s_blk_ROOT__o_done" type="internal"/><state id="s_blk_REQ" initial="s_blk_REQ__waiting"><state id="s_blk_REQ__waiting"><onentry><send delay="14d" event="statifier_blocks.await.blk_REQ" id="s_blk_REQ__send"/></onentry><transition event="loan.requested" target="s_blk_REQ__o_received"><if cond="_event.data.copy_id !== undefined"><assign expr="_event.data.copy_id" location="loan.copy_id"/></if><if cond="_event.data.desk.name !== undefined"><assign expr="_event.data.desk.name" location="loan.desk"/></if><assign expr="&quot;desk&quot;" location="loan.source"/></transition><transition event="statifier_blocks.await.blk_REQ" target="s_blk_REQ__o_timed_out"/></state><final id="s_blk_REQ__o_received"><onentry><raise event="done.outcome.s_blk_REQ.received"/></onentry></final><final id="s_blk_REQ__o_timed_out"><onentry><raise event="done.outcome.s_blk_REQ.timed_out"/></onentry></final></state><final id="s_blk_ROOT__o_done"><onentry><raise event="done.outcome.s_blk_ROOT.done"/></onentry></final></state></scxml>