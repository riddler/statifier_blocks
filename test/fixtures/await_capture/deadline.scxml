<scxml initial="s_blk_ROOT" name="bdoc_AWAITDEADLINE" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_ROOT" initial="s_blk_RET"><onexit><cancel sendid="s_blk_RET__send"/></onexit><transition event="done.state.s_blk_RET" target="s_blk_ROOT__o_done" type="internal"/><state id="s_blk_RET" initial="s_blk_RET__waiting"><state id="s_blk_RET__waiting"><onentry><send delay="14d" event="statifier_blocks.await.blk_RET" id="s_blk_RET__send"/></onentry><transition event="copy.returned" target="s_blk_RET__o_received"/><transition event="statifier_blocks.await.blk_RET" target="s_blk_RET__o_timed_out"/></state><final id="s_blk_RET__o_received"><onentry><raise event="done.outcome.s_blk_RET.received"/></onentry></final><final id="s_blk_RET__o_timed_out"><onentry><raise event="done.outcome.s_blk_RET.timed_out"/></onentry></final></state><final id="s_blk_ROOT__o_done"><onentry><raise event="done.outcome.s_blk_ROOT.done"/></onentry></final></state></scxml>