<scxml initial="s_blk_PROOT" name="bdoc_01JPATRONREG" version="1.0" xmlns="http://www.w3.org/2005/07/scxml"><state id="s_blk_PROOT" initial="s_blk_PGRP"><transition event="done.state.s_blk_PGRP" target="s_blk_PROOT__o_done" type="internal"/><state id="s_blk_PGRP" initial="s_blk_PGRP__run"><transition event="done.state.s_blk_PGRP__body" target="s_blk_PGRP__o_done" type="internal"/><transition event="statifier_blocks.interrupt.abandon.s_blk_PGRP" target="s_blk_PGRP__o_done" type="internal"/><transition event="statifier_blocks.interrupt.resume.s_blk_PGRP" target="s_blk_PGRP__run" type="internal"/><parallel id="s_blk_PGRP__run"><state id="s_blk_PGRP__body" initial="s_blk_PDLN"><onexit><cancel sendid="s_blk_PDLN__send"/></onexit><transition event="done.state.s_blk_PDLN" target="s_blk_PVER" type="internal"/><transition event="done.state.s_blk_PVER" target="s_blk_PGRP__body_done" type="internal"/><state id="s_blk_PDLN" initial="s_blk_PDLN__o_done"><onentry><send delay="24h" event="registration.deadline" id="s_blk_PDLN__send"/></onentry><final id="s_blk_PDLN__o_done"><onentry><raise event="done.outcome.s_blk_PDLN.done"/></onentry></final></state><state id="s_blk_PVER" initial="s_blk_PVER__waiting"><state id="s_blk_PVER__waiting"><transition event="email.verified" target="s_blk_PVER__o_received"/></state><final id="s_blk_PVER__o_received"><onentry><raise event="done.outcome.s_blk_PVER.received"/></onentry></final></state><final id="s_blk_PGRP__body_done"/></state><state id="s_blk_PABN" initial="s_blk_PABN__armed"><state id="s_blk_PABN__armed"><transition event="registration.abandoned" target="s_blk_PABN__o_done"><raise event="statifier_blocks.interrupt.abandon.s_blk_PGRP"/></transition></state><final id="s_blk_PABN__o_done"><onentry><raise event="done.outcome.s_blk_PABN.done"/></onentry></final></state><state id="s_blk_PEXP" initial="s_blk_PEXP__armed"><state id="s_blk_PEXP__armed"><transition event="registration.deadline" target="s_blk_PEXP__o_done"><raise event="statifier_blocks.interrupt.abandon.s_blk_PGRP"/></transition></state><final id="s_blk_PEXP__o_done"><onentry><raise event="done.outcome.s_blk_PEXP.done"/></onentry></final></state></parallel><final id="s_blk_PGRP__o_done"><onentry><raise event="done.outcome.s_blk_PGRP.done"/></onentry></final></state><final id="s_blk_PROOT__o_done"><onentry><raise event="done.outcome.s_blk_PROOT.done"/></onentry></final></state></scxml>