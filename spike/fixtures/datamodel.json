{
  "_comment": [
    "The typed datamodel the spike's datamodel panel and condition editor read.",
    "Not an ADR-0001 artifact: no accepted record defines a datamodel document",
    "yet, so this shape is the spike's proposal and journalling it is part of W3.",
    "Shape: three scopes - 'global' (host-owned, same for every run), 'local'",
    "(chart-local, one per run), 'event' (the payload of the event currently being",
    "handled; its entries are addressed with the 'event.' prefix in conditions).",
    "Type set: string, integer, decimal, boolean, datetime, duration, object, list.",
    "Per ADR-0001 decision 6 there are no floats anywhere - money is integer minor",
    "units and a decimal is carried as a string.",
    "Invariant this fixture is held to: every datamodel path named in a 'cond' in",
    "documents/*.json resolves to an entry here. Both directions were walked by",
    "hand when the fixtures were written (sb-ajk)."
  ],
  "version": 1,
  "scopes": [
    {
      "scope": "global",
      "label": "Global",
      "description": "Host-owned configuration. The same for every run of every chart.",
      "entries": [
        {
          "name": "merchant",
          "path": "merchant",
          "type": "object",
          "label": "Merchant",
          "fields": [
            {
              "name": "id",
              "path": "merchant.id",
              "type": "string",
              "label": "Merchant id",
              "example": "mer_9f2c"
            },
            {
              "name": "country",
              "path": "merchant.country",
              "type": "string",
              "label": "Country",
              "example": "US"
            },
            {
              "name": "currency",
              "path": "merchant.currency",
              "type": "string",
              "label": "Settlement currency",
              "example": "USD"
            },
            {
              "name": "risk_tier",
              "path": "merchant.risk_tier",
              "type": "string",
              "label": "Risk tier",
              "example": "standard"
            },
            {
              "name": "settlement_fx_rate",
              "path": "merchant.settlement_fx_rate",
              "type": "decimal",
              "label": "Settlement FX rate",
              "example": "1.0000",
              "note": "Decimal carried as a string - ADR-0001 decision 6 forbids floats."
            }
          ]
        },
        {
          "name": "limits",
          "path": "limits",
          "type": "object",
          "label": "Limits",
          "fields": [
            {
              "name": "daily_capture_cap_cents",
              "path": "limits.daily_capture_cap_cents",
              "type": "integer",
              "label": "Daily capture cap (minor units)",
              "example": 5000000
            },
            {
              "name": "manual_review_backlog",
              "path": "limits.manual_review_backlog",
              "type": "integer",
              "label": "Manual review backlog",
              "example": 12
            },
            {
              "name": "authorization_window",
              "path": "limits.authorization_window",
              "type": "duration",
              "label": "Authorization window",
              "example": "PT15M"
            }
          ]
        },
        {
          "name": "feature_flags",
          "path": "feature_flags",
          "type": "object",
          "label": "Feature flags",
          "fields": [
            {
              "name": "three_ds_required",
              "path": "feature_flags.three_ds_required",
              "type": "boolean",
              "label": "3DS required",
              "example": true
            },
            {
              "name": "legacy_check_enabled",
              "path": "feature_flags.legacy_check_enabled",
              "type": "boolean",
              "label": "Legacy check enabled",
              "example": false
            }
          ]
        }
      ]
    },
    {
      "scope": "local",
      "label": "Chart-local",
      "description": "One per run. Written by the steps of the chart as it goes.",
      "entries": [
        {
          "name": "started_at",
          "path": "started_at",
          "type": "datetime",
          "label": "Started at",
          "example": "2026-08-28T09:14:03Z"
        },
        {
          "name": "amount_cents",
          "path": "amount_cents",
          "type": "integer",
          "label": "Amount (minor units)",
          "example": 42350
        },
        {
          "name": "amount",
          "path": "amount",
          "type": "decimal",
          "label": "Amount (display)",
          "example": "423.50"
        },
        {
          "name": "currency",
          "path": "currency",
          "type": "string",
          "label": "Currency",
          "example": "USD"
        },
        {
          "name": "capture_attempts",
          "path": "capture_attempts",
          "type": "integer",
          "label": "Capture attempts",
          "example": 1
        },
        {
          "name": "risk_rating",
          "path": "risk_rating",
          "type": "integer",
          "label": "Risk rating",
          "example": 34
        },
        {
          "name": "risk_reasons",
          "path": "risk_reasons",
          "type": "list",
          "item_type": "string",
          "label": "Risk reasons",
          "example": ["velocity", "new_device"]
        },
        {
          "name": "card",
          "path": "card",
          "type": "object",
          "label": "Card",
          "fields": [
            {
              "name": "brand",
              "path": "card.brand",
              "type": "string",
              "label": "Brand",
              "example": "visa"
