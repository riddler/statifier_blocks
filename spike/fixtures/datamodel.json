              "label": "Required",
              "example": true
            },
            {
              "name": "completed",
              "path": "three_ds.completed",
              "type": "boolean",
              "label": "Completed",
              "example": false
            },
            {
              "name": "status",
              "path": "three_ds.status",
              "type": "string",
              "label": "Status",
              "example": "challenge_sent"
            }
          ]
        },
        {
          "name": "auth",
          "path": "auth",
          "type": "object",
          "label": "Authorization",
          "fields": [
            {
              "name": "approved",
              "path": "auth.approved",
              "type": "boolean",
              "label": "Approved",
              "example": true
            },
            {
              "name": "captured",
              "path": "auth.captured",
              "type": "boolean",
              "label": "Captured",
              "example": false
            },
            {
              "name": "code",
              "path": "auth.code",
              "type": "string",
              "label": "Authorization code",
              "example": "A71C09"
            },
            {
              "name": "network_ref",
              "path": "auth.network_ref",
