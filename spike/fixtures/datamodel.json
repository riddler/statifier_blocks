              "label": "Last four",
              "example": "4242"
            },
            {
              "name": "active",
              "path": "card.active",
              "type": "boolean",
              "label": "Active",
              "example": true
            },
            {
              "name": "expires_at",
              "path": "card.expires_at",
              "type": "datetime",
              "label": "Expires at",
              "example": "2029-01-31T00:00:00Z"
