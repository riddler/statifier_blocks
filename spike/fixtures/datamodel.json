    {
      "scope": "event",
      "label": "Event payload",
      "description": "The payload of the event being handled. Addressed with the 'event.' prefix in conditions; only the entry matching the event currently in flight is populated.",
      "entries": [
        {
          "name": "name",
          "path": "event.name",
          "type": "string",
          "label": "Event name",
          "example": "customer.cancelled"
        },
        {
          "name": "received_at",
          "path": "event.received_at",
          "type": "datetime",
          "label": "Received at",
          "example": "2026-08-28T09:22:01Z"
        },
        {
          "name": "customer_cancelled",
          "path": "event.customer_cancelled",
          "type": "object",
          "label": "customer.cancelled",
          "fields": [
            {
              "name": "reason",
              "path": "event.customer_cancelled.reason",
              "type": "string",
              "label": "Reason",
              "example": "customer_request",
              "one_of": ["customer_request", "duplicate", "timeout"]
            },
            {
              "name": "at",
              "path": "event.customer_cancelled.at",
              "type": "datetime",
              "label": "Cancelled at",
              "example": "2026-08-28T09:21:58Z"
            }
          ]
        },
        {
          "name": "review_resolved",
          "path": "event.review_resolved",
          "type": "object",
          "label": "review.resolved",
          "fields": [
            {
              "name": "decision",
              "path": "event.review_resolved.decision",
              "type": "string",
              "label": "Decision",
              "example": "approve",
              "one_of": ["approve", "decline"]
            },
            {
              "name": "reviewer_id",
              "path": "event.review_resolved.reviewer_id",
              "type": "string",
              "label": "Reviewer id",
              "example": "usr_7d1e"
            },
            {
              "name": "notes",
              "path": "event.review_resolved.notes",
              "type": "string",
              "label": "Notes",
              "example": ""
            }
          ]
        },
        {
          "name": "three_ds_completed",
          "path": "event.three_ds_completed",
          "type": "object",
          "label": "card.three_ds_completed",
          "fields": [
            {
              "name": "status",
              "path": "event.three_ds_completed.status",
              "type": "string",
              "label": "Status",
              "example": "authenticated",
              "one_of": ["authenticated", "failed", "unavailable"]
