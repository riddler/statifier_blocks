        },
        {
          "name": "customer",
          "path": "customer",
          "type": "object",
          "label": "Customer",
          "fields": [
            {
              "name": "id",
              "path": "customer.id",
              "type": "string",
              "label": "Customer id",
              "example": "cus_31b8"
            },
            {
              "name": "email",
              "path": "customer.email",
              "type": "string",
              "label": "Email",
              "example": "avery@example.com"
            },
            {
              "name": "tenure_days",
              "path": "customer.tenure_days",
              "type": "integer",
              "label": "Tenure (days)",
              "example": 512
            },
            {
              "name": "verified",
              "path": "customer.verified",
              "type": "boolean",
              "label": "Verified",
              "example": true
            }
          ]
        },
        {
          "name": "validation",
          "path": "validation",
          "type": "object",
          "label": "Validation",
          "fields": [
            {
              "name": "passed",
              "path": "validation.passed",
              "type": "boolean",
              "label": "Passed",
              "example": true
            },
            {
              "name": "errors",
              "path": "validation.errors",
