          ]
        },
        {
          "name": "fraud",
          "path": "fraud",
          "type": "object",
          "label": "Fraud",
          "fields": [
            {
              "name": "verdict",
              "path": "fraud.verdict",
              "type": "string",
              "label": "Verdict",
