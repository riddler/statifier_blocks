              "label": "Available (minor units)",
              "example": 91200
            },
            {
              "name": "checked",
              "path": "balance.checked",
              "type": "boolean",
              "label": "Checked",
              "example": true
            }
          ]
        },
        {
          "name": "three_ds",
          "path": "three_ds",
          "type": "object",
          "label": "3DS",
          "fields": [
            {
              "name": "required",
