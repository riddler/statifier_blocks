            {
              "name": "rated_at",
              "path": "fraud.rated_at",
              "type": "datetime",
              "label": "Rated at",
              "example": "2026-08-28T09:14:11Z"
            }
          ]
        },
        {
          "name": "balance",
          "path": "balance",
          "type": "object",
          "label": "Balance",
          "fields": [
            {
              "name": "available_cents",
              "path": "balance.available_cents",
